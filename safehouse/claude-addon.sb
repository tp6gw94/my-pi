;; ---------------------------------------------------------------------------
;; Claude Code config addon (local)
;; Grants read/write access to the whole ~/.claude directory.
;; custom-pi.sb only allows ~/.claude/agents and ~/.claude/skills read-only,
;; but pi-claude-bridge runs Claude Code, which writes sessions, todos, and
;; settings under ~/.claude.
;; ---------------------------------------------------------------------------

(allow file-read* file-write*
    (home-subpath "/.claude")
)
