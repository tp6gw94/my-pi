;; ---------------------------------------------------------------------------
;; Claude Code config addon (local)
;; Grants read-only access to the whole ~/.claude directory.
;; custom-pi.sb only allows ~/.claude/agents and ~/.claude/skills, so other
;; Claude Code files (settings, commands, plugins, projects) fail with EPERM.
;; ---------------------------------------------------------------------------

(allow file-read*
    (home-subpath "/.claude")
)
