#!/usr/bin/env bash
set -euo pipefail

# Custom sandbox wrapper for Pi.
# Mirrors Agent Safehouse assembly but uses a static base profile, appends
# the browser addon by default, and appends the invocation directory as a
# read/write workdir at launch time.

BASE_PROFILE="${BASE_PROFILE:-$HOME/.pi/safehouse/custom-pi.sb}"
BROWSER_ADDON="${BROWSER_ADDON:-$HOME/.pi/safehouse/browser-addon.sb}"
KEYCHAIN_ADDON="${KEYCHAIN_ADDON:-$HOME/.pi/safehouse/keychain-addon.sb}"
EMACS_ADDON="${EMACS_ADDON:-$HOME/.pi/safehouse/emacs-addon.sb}"
PI_XDG_ADDON="${PI_XDG_ADDON:-$HOME/.pi/safehouse/pi-xdg-addon.sb}"

if [[ ! -f "$BASE_PROFILE" ]]; then
  echo "Base profile not found: $BASE_PROFILE" >&2
  exit 1
fi

if [[ ! -f "$BROWSER_ADDON" ]]; then
  echo "Browser addon not found: $BROWSER_ADDON" >&2
  exit 1
fi

WORKDIR="$(pwd -P)"

# Escape a string for use inside an SBPL double-quoted string.
_sb_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# Emit file-read* literal rules for every ancestor of $WORKDIR (including /).
# This matches Safehouse's emit_path_ancestor_literals() behavior.
_emit_workdir_ancestors() {
  local path="$1"
  local trimmed current=""

  printf '    (literal "/")\n'

  trimmed="${path#/}"
  if [[ -n "$trimmed" ]]; then
    local IFS='/'
    local -a parts=()
    read -r -a parts <<< "$trimmed"
    for part in "${parts[@]}"; do
      [[ -z "$part" ]] && continue
      current="${current}/${part}"
      printf '    (literal "%s")\n' "$(_sb_escape "$current")"
    done
  fi
}

# Paths containing control characters cannot be represented safely by the
# generated SBPL and are rejected instead of interpolated.
_path_has_unsafe_chars() {
  case "$1" in
    *[[:cntrl:]]*) return 1 ;;
  esac
}

# Preserve command status and trailing newlines while reading one Git path.
_git_value() {
  local value

  value="$(
    set +e
    command git "$@"
    status=$?
    printf '\001'
    exit "$status"
  )" || return 1

  case "$value" in
    *$'\001') ;;
    *) return 1 ;;
  esac
  value="${value%$'\001'}"
  value="${value%$'\n'}"
  _path_has_unsafe_chars "$value" || return 1
  printf '%s' "$value"
}

_canonical_dir() {
  local value

  [[ -d "$1" ]] || return 1
  value="$(
    cd "$1" 2>/dev/null || exit 1
    pwd -P || exit 1
    printf '\001'
  )" || return 1

  case "$value" in
    *$'\001') ;;
    *) return 1 ;;
  esac
  value="${value%$'\001'}"
  value="${value%$'\n'}"
  _path_has_unsafe_chars "$value" || return 1
  printf '%s' "$value"
}

_detect_current_worktree_root() {
  local root

  root="$(_git_value rev-parse --path-format=absolute --show-toplevel 2>/dev/null || true)"
  if [[ -z "$root" ]]; then
    root="$(_git_value rev-parse --show-toplevel 2>/dev/null || true)"
  fi
  [[ -n "$root" ]] || return 0
  _canonical_dir "$root"
}

# Absolute path of the shared git common dir, or empty if not in a repo.
# Needed so commit/reset/av can write refs/objects when .git lives outside WORKDIR
# (linked worktree, or safe-pi launched from a subdirectory).
_detect_git_common_dir() {
  local d

  d="$(_git_value rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -z "$d" ]]; then
    d="$(_git_value rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -n "$d" && "$d" != /* ]]; then
      d="$WORKDIR/$d"
    fi
  fi

  [[ -n "$d" ]] || return 0
  _canonical_dir "$d" || return 0
}

_candidate_git_common_dir() {
  local candidate="$1" candidate_root="$2" d

  d="$(_git_value -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -z "$d" ]]; then
    d="$(_git_value -C "$candidate" rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -n "$d" && "$d" != /* ]]; then
      d="$candidate_root/$d"
    fi
  fi

  [[ -n "$d" ]] || return 1
  _canonical_dir "$d"
}

_consider_worktree_record() {
  local path="$1" bare="$2" prunable="$3"
  local candidate candidate_root candidate_common
  local current_root="$4" source_common="$5"

  [[ "$bare" -eq 0 && "$prunable" -eq 0 ]] || return 0
  [[ -n "$path" && "$path" == /* ]] || return 0
  if ! _path_has_unsafe_chars "$path"; then
    echo "safe-pi: skipping a Git worktree with an unsafe path" >&2
    return 0
  fi
  candidate="$(_canonical_dir "$path" 2>/dev/null || true)"
  [[ -n "$candidate" ]] || return 0
  [[ "$candidate" != "$current_root" ]] || return 0

  candidate_root="$(_git_value -C "$candidate" rev-parse --path-format=absolute --show-toplevel 2>/dev/null || true)"
  if [[ -z "$candidate_root" ]]; then
    candidate_root="$(_git_value -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true)"
  fi
  candidate_root="$(_canonical_dir "$candidate_root" 2>/dev/null || true)"
  [[ -n "$candidate_root" && "$candidate_root" == "$candidate" ]] || return 0

  candidate_common="$(_candidate_git_common_dir "$candidate" "$candidate_root" 2>/dev/null || true)"
  [[ -n "$candidate_common" && "$candidate_common" == "$source_common" ]] || return 0

  local existing
  if ((${#WORKTREE_PATHS[@]})); then
    for existing in "${WORKTREE_PATHS[@]}"; do
      [[ "$existing" == "$candidate" ]] && return 0
    done
  fi
  WORKTREE_PATHS+=("$candidate")
}

# Snapshot all valid worktrees belonging to the current repository. New RO
# grants apply on restart, do not revoke existing RW grants, and Git common
# metadata remains RW for normal Git operations (not a full Git isolation).
_detect_worktree_paths() {
  local current_root source_common superproject snapshot
  local field record_path record_has_path record_bare record_prunable
  local snapshot_valid saw_record

  WORKTREE_PATHS=()
  current_root="$(_detect_current_worktree_root 2>/dev/null || true)"
  [[ -n "$current_root" ]] || return 0
  superproject="$(_git_value rev-parse --show-superproject-working-tree 2>/dev/null || true)"
  [[ -z "$superproject" ]] || return 0
  source_common="$(_detect_git_common_dir 2>/dev/null || true)"
  [[ -n "$source_common" ]] || return 0

  snapshot="$(mktemp "${TMPDIR:-/tmp}/safe-pi-worktrees.XXXXXX")" || return 0
  if ! command git worktree list --porcelain -z > "$snapshot" 2>/dev/null; then
    rm -f "$snapshot"
    echo "safe-pi: Git worktree snapshot unavailable; skipping additional worktree access" >&2
    return 0
  fi

  record_path=""
  record_has_path=0
  record_bare=0
  record_prunable=0
  snapshot_valid=1
  saw_record=0
  while IFS= read -r -d '' field; do
    if [[ -z "$field" ]]; then
      if [[ "$record_has_path" -eq 0 || -z "$record_path" ]]; then
        snapshot_valid=0
      else
        saw_record=1
        _consider_worktree_record "$record_path" "$record_bare" "$record_prunable" "$current_root" "$source_common"
      fi
      record_path=""
      record_has_path=0
      record_bare=0
      record_prunable=0
    elif [[ "$field" == worktree\ * ]]; then
      if [[ "$record_has_path" -ne 0 ]]; then
        snapshot_valid=0
      fi
      record_path="${field#worktree }"
      record_has_path=1
    elif [[ "$field" == bare ]]; then
      record_bare=1
    elif [[ "$field" == prunable\ * || "$field" == prunable ]]; then
      record_prunable=1
    fi
  done < "$snapshot"
  rm -f "$snapshot"

  [[ -z "$field" && "$record_has_path" -eq 0 ]] || snapshot_valid=0
  [[ "$saw_record" -ne 0 ]] || snapshot_valid=0
  if [[ "$snapshot_valid" -eq 0 ]]; then
    WORKTREE_PATHS=()
    echo "safe-pi: incomplete Git worktree snapshot; skipping additional worktree access" >&2
  fi
}

APPEND_PATHS=()
PI_ARGS=()
while (($# > 0)); do
  case "$1" in
    --append-path)
      if (($# < 2)); then
        echo "--append-path requires a path" >&2
        exit 1
      fi
      APPEND_PATHS+=("$2")
      shift 2
      ;;
    --append-path=*)
      APPEND_PATHS+=("${1#--append-path=}")
      shift
      ;;
    --)
      PI_ARGS+=("$@")
      break
      ;;
    *)
      PI_ARGS+=("$1")
      shift
      ;;
  esac
done

for i in "${!APPEND_PATHS[@]}"; do
  path="${APPEND_PATHS[$i]}"
  if [[ -z "$path" ]]; then
    echo "--append-path cannot be empty" >&2
    exit 1
  fi
  if [[ "$path" != /* ]]; then
    path="$WORKDIR/$path"
  fi
  if [[ ! -d "$path" ]]; then
    echo "--append-path must name an existing directory: ${APPEND_PATHS[$i]}" >&2
    exit 1
  fi
  APPEND_PATHS[i]="$(cd "$path" && pwd -P)"
done

TMP_POLICY="$(mktemp "${TMPDIR:-/tmp}/safe-pi-policy.XXXXXX")"
trap 'rm -f "$TMP_POLICY"' EXIT

# Render the HOME_DIR placeholder at launch time so the profile stays
# machine-independent (mirrors safehouse bin/lib/policy/render.sh).
HOME_DIR="$(cd "$HOME" && pwd -P)"
sed "s|__SAFEHOUSE_HOME_DIR__|$(_sb_escape "$HOME_DIR")|g" "$BASE_PROFILE" > "$TMP_POLICY"

if grep -q '__SAFEHOUSE_HOME_DIR__' "$TMP_POLICY"; then
  echo "Failed to render HOME_DIR placeholder in: $BASE_PROFILE" >&2
  exit 1
fi

if ! grep -q "^(define HOME_DIR \"" "$TMP_POLICY"; then
  echo "Base profile has no HOME_DIR definition: $BASE_PROFILE" >&2
  exit 1
fi

{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Browser addon (loaded by default)
;; Source: ${BROWSER_ADDON}
;; ---------------------------------------------------------------------------
EOF
  cat "$BROWSER_ADDON"
} >> "$TMP_POLICY"

# Append keychain addon if present (read-only, may not exist on all setups).
if [[ -f "$KEYCHAIN_ADDON" ]]; then
{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Keychain addon (loaded by default if the addon file exists)
;; Source: ${KEYCHAIN_ADDON}
;; ---------------------------------------------------------------------------
EOF
  cat "$KEYCHAIN_ADDON"
} >> "$TMP_POLICY"
fi

# Emacs /Applications read + user emacs dirs.
if [[ -f "$EMACS_ADDON" ]]; then
{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Emacs addon (loaded by default if the addon file exists)
;; Source: ${EMACS_ADDON}
;; ---------------------------------------------------------------------------
EOF
  cat "$EMACS_ADDON"
} >> "$TMP_POLICY"
fi

# XDG config dir used by Pi extensions (e.g. pi-web-access web-search.json).
if [[ -f "$PI_XDG_ADDON" ]]; then
{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Pi XDG config addon (loaded by default if the addon file exists)
;; Source: ${PI_XDG_ADDON}
;; ---------------------------------------------------------------------------
EOF
  cat "$PI_XDG_ADDON"
} >> "$TMP_POLICY"
fi

# Tell Playwright-backed browser automation not to re-init an inner sandbox.
export PLAYWRIGHT_MCP_SANDBOX=false

# pi-subagents spawns children via bare `pi`, walking PATH. Under the sandbox,
# early PATH entries outside the profile (e.g. ~/.config/bin, ~/.kiro/bin) make
# that PATH walk fail with spawn EPERM before reaching mise's pi. Resolve pi
# once here (outside the sandbox) and hand subagents the absolute path.
if [[ -z "${PI_SUBAGENT_PI_BINARY:-}" ]]; then
  if PI_RESOLVED="$(command -v pi 2>/dev/null)"; then
    export PI_SUBAGENT_PI_BINARY="$PI_RESOLVED"
  fi
fi

{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Launch-time workdir access
;; Generated for: ${WORKDIR}
;; ---------------------------------------------------------------------------
(allow file-read*
$(_emit_workdir_ancestors "$WORKDIR")
)
(allow file-read* file-write* (subpath "$(_sb_escape "$WORKDIR")"))
EOF
} >> "$TMP_POLICY"

{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; User-local executables and XDG data access
;; ---------------------------------------------------------------------------
(allow file-read* (subpath "$(_sb_escape "$HOME_DIR/.local/bin")"))
(allow file-read* file-write* (subpath "$(_sb_escape "$HOME_DIR/.local/share")"))
EOF
} >> "$TMP_POLICY"

if ((${#APPEND_PATHS[@]})); then
  for append_path in "${APPEND_PATHS[@]}"; do
  {
    cat <<EOF

;; ---------------------------------------------------------------------------
;; Launch-time appended path access
;; Generated for one --append-path value
;; ---------------------------------------------------------------------------
(allow file-read*
$(_emit_workdir_ancestors "$append_path")
)
(allow file-read* file-write* (subpath "$(_sb_escape "$append_path")"))
EOF
  } >> "$TMP_POLICY"
  done
fi

# Snapshot valid worktrees from this repository and grant each non-current
# worktree read-only access. The snapshot is taken at launch, so new worktrees
# require a restart; existing WORKDIR/append-path RW grants remain unchanged.
_detect_worktree_paths
if ((${#WORKTREE_PATHS[@]})); then
  for worktree_path in "${WORKTREE_PATHS[@]}"; do
  {
    cat <<EOF

;; ---------------------------------------------------------------------------
;; Other worktree read access (launch-time snapshot)
;; Worktree: ${worktree_path}
;; ---------------------------------------------------------------------------
(allow file-read*
$(_emit_workdir_ancestors "$worktree_path")
)
(allow file-read* (subpath "$(_sb_escape "$worktree_path")"))
EOF
  } >> "$TMP_POLICY"
  done
fi

# RW on shared git metadata so reset/commit/amend/av restack/pr can update
# refs, objects, and .git/av even when common-dir is outside WORKDIR.
GIT_COMMON_DIR="$(_detect_git_common_dir)"
if [[ -n "$GIT_COMMON_DIR" ]]; then
{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Git common-dir write access (commit / reset / av)
;; Common dir: ${GIT_COMMON_DIR}
;; ---------------------------------------------------------------------------
(allow file-read*
$(_emit_workdir_ancestors "$GIT_COMMON_DIR")
)
(allow file-read* file-write* (subpath "$(_sb_escape "$GIT_COMMON_DIR")"))
EOF
} >> "$TMP_POLICY"
fi

# Aviator CLI config (stack metadata lives under .git; this is auth/settings).
AV_CONFIG_DIR="${AV_HOME:-$HOME/.config/av}"
{
  cat <<EOF

;; ---------------------------------------------------------------------------
;; Aviator CLI (av) config
;; AV_HOME / config: ${AV_CONFIG_DIR}
;; ---------------------------------------------------------------------------
(allow file-read* file-write* (subpath "$(_sb_escape "$AV_CONFIG_DIR")"))
EOF
} >> "$TMP_POLICY"

# Mirror Safehouse runtime_build_sanitized_exec_path: bare names like rg/fd
# must resolve without requiring /opt/homebrew/bin/... full paths.
_ensure_path_entry() {
  local entry="$1"
  case ":${PATH:-}:" in
    *:"$entry":*) return 0 ;;
  esac
  PATH="${PATH:+$PATH:}$entry"
}
_ensure_path_entry /usr/local/bin
_ensure_path_entry /usr/local/sbin
_ensure_path_entry /opt/homebrew/bin
_ensure_path_entry /opt/homebrew/sbin
_ensure_path_entry "$HOME/.local/bin"
export PATH

if ((${#PI_ARGS[@]})); then
  exec sandbox-exec -f "$TMP_POLICY" -- pi "${PI_ARGS[@]}"
fi
exec sandbox-exec -f "$TMP_POLICY" -- pi
