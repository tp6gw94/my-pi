{
  "lastChangelogVersion": "0.99.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "extensions/deepinfra-provider",
    "npm:pi-btw"
  ],
  "theme": "github-light",
  "subagents": {
    "watchdog": {
      "enabled": false,
      "main": {
        "model": "vercel-ai-gateway/zai/glm-5.3",
        "thinking": "high"
      },
      "scope": {
        "enabled": true
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "researcher": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "planner": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high"
      },
      "worker": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high",
        "skills": [
          "ponytail"
        ]
      },
      "context-builder": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low"
      }
    }
  },
  "modelThinkingLevels": {
    "xai/grok-4.6": "high",
    "openai-codex/gpt-5.6-luna": "max",
    "openai-codex/gpt-6-astra": "medium",
    "openai-codex/gpt-6-sol": "high"
  },
  "hideThinkingBlock": true
}
