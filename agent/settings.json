{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access@0.19.0",
    "npm:pi-mcp-adapter",
    "git:github.com/DietrichGebert/ponytail",
    "extensions/deepinfra-provider",
    "git:github.com/tp6gw94/pi-review-triage@v0.1.6",
    "git:github.com/tp6gw94/pi-ocr-hunk@v0.1.1",
    "npm:pi-btw",
    "https://github.com/cathrynlavery/diagram-design"
  ],
  "theme": "github-light",
  "subagents": {
    "watchdog": {
      "enabled": true,
      "main": {
        "model": "deepinfra/zai-org/GLM-5.3",
        "thinking": "high"
      },
      "scope": {
        "enabled": true
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna",
          "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash"
        ]
      },
      "researcher": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna",
          "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash"
        ]
      },
      "planner": {
        "model": "opencode-go/opencode-go/mimo-v2.6-pro",
        "thinking": "medium",
        "fallbackModels": [
          "deepinfra/moonshotai/Kimi-K3"
        ]
      },
      "reviewer": {
        "model": "opencode-zen-compat/muse-spark-1.3-contributor-free",
        "thinking": "high",
        "fallbackModels": [
          "deepinfra/moonshotai/Kimi-K3"
        ]
      },
      "oracle": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high",
        "fallbackModels": [
          "deepinfra/moonshotai/Kimi-K3"
        ]
      },
      "worker": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high",
        "fallbackModels": [
          "deepseek/deepseek-flash",
          "openai-codex/gpt-5.6-luna",
          "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash"
        ],
        "skills": [
          "ponytail"
        ]
      },
      "context-builder": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "low",
        "fallbackModels": [
          "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash",
          "deepinfra/zai-org/GLM-5.3-Flash"
        ]
      }
    }
  },
  "modelThinkingLevels": {
    "xai/grok-4.6": "high",
    "openai-codex/gpt-5.6-luna": "max",
    "openai-codex/gpt-6-astra": "medium"
  },
  "hideThinkingBlock": true
}
